rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // الصور عامة القراءة (كتالوج/إشعارات تظهر لكل المستخدمين).
    // الكتابة للأدمن فقط — كل الرفع يتم من لوحة الأدمن.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
