#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android release signing secrets (never commit)
/android/key.properties
/android/keystore/
*.jks
*.keystore

# Firebase Admin SDK (server only - never ship in app)
*firebase-adminsdk*.json
*-adminsdk-*.json

# Build artifacts / caches (not source code)
/android/build/
.firebase/

# APK/AAB build outputs and scratch folders (not source)
*.apk
*.aab
/release/
/tmp_icon/

# Generated maintenance report (contains order data)
scripts/uncharged_fazer_orders_report.json

